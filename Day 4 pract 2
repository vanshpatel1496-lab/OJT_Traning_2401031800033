<!DOCTYPE html>
<html>

<head>

<title>CSS Types Example</title>

<!-- External CSS -->
<link rel="stylesheet" href="style.css">

<!-- Internal CSS -->
<style>

h2{
    color:blue;
}

.internal{
    background:lightgray;
    font-size:20px;
    padding:10px;
}

</style>

</head>

<body>

<!-- Inline CSS -->

<h1 style="color:red; background:yellow;">
    Inline CSS Example
</h1>

<p style="font-size:18px;">
    This paragraph uses Inline CSS.
</p>

<br>

<!-- Internal CSS -->

<h2>Internal CSS Example</h2>

<p class="internal">
    This paragraph uses Internal CSS.
</p>

<br>

<!-- External CSS -->

<h3>External CSS Example</h3>

<p class="external">
    This paragraph uses External CSS.
</p>

</body>
</html>
