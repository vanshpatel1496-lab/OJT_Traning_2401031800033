<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>W3Schools Clone</title>
<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial;
}
body{
    background:#f1f1f1;
}
/* HEADER */
.header{
    background:white;
    border-bottom:1px solid #ccc;
    position:sticky;
    top:0;
}
/* TOP HEADER */
.top-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:15px 20px;
    flex-wrap:wrap;
}
/* LEFT SIDE */
.left{
    display:flex;
    align-items:center;
    gap:20px;
}
.logo{
    font-size:28px;
    font-weight:bold;
    color:#04AA6D;
}
/* MENU */
.menu{
    display:flex;
    gap:15px;
}
.menu a{
    text-decoration:none;
    color:black;
    padding:8px;
}
.menu a:hover{
    background:#04AA6D;
    color:white;
}
/* RIGHT SIDE */
.right{
    display:flex;
    align-items:center;
    gap:15px;
}
.search{
    border:1px solid #ccc;
    border-radius:20px;
    padding:5px 10px;
    background:white;
}
.search input{
    border:none;
    outline:none;
}
/* BUTTON */
.btn{
    background:#04AA6D;
    color:white;
    border:none;
    padding:8px 18px;
    border-radius:20px;
    cursor:pointer;
}
/* COURSE BAR */
.course-bar{
    background:#282A35;
    overflow:auto;
    white-space:nowrap;
}
.course-bar a{
    display:inline-block;
    color:white;
    text-decoration:none;
    padding:12px 15px;
}
.course-bar a:hover{
    background:#04AA6D;
}
.active{
    background:#04AA6D;
}
/* HOLY GRAIL LAYOUT */
.grail-container{
    display:grid;
    grid-template-columns:200px 1fr 200px;
    gap:20px;
    width:90%;
    margin:30px auto;
}
/* LEFT SIDEBAR */
.sidebar-left{
    background:white;
    padding:20px;
    border-radius:10px;
}
.sidebar-left h3{
    margin-bottom:15px;
    color:#04AA6D;
}
.sidebar-left p{
    margin:10px 0;
}
/* MAIN CONTENT */
.main-content{
    background:white;
    padding:20px;
    border-radius:10px;
}
/* TABLE */
table{
    width:100%;
    border-collapse:collapse;
    margin-top:20px;
}
table th{
    background:#04AA6D;
    color:white;
    padding:12px;
}
table td{
    border:1px solid #ccc;
    padding:10px;
    text-align:center;
}
tr:nth-child(even){
    background:#f2f2f2;
}
/* LOGIN FORM */
.login-box{
    width:100%;
    margin-top:30px;
}
.login-box h2{
    color:#04AA6D;
    margin-bottom:15px;
}
.login-box input{
    width:100%;
    padding:10px;
    margin:10px 0;
    border:1px solid #ccc;
    border-radius:5px;
}
.login-box button{
    width:100%;
    padding:10px;
    background:#04AA6D;
    color:white;
    border:none;
    border-radius:5px;
}
/* RIGHT SIDEBAR */
.sidebar-right{
    background:white;
    padding:20px;
    border-radius:10px;
}
.sidebar-right h3{
    margin-bottom:15px;
    color:#04AA6D;
}
/* ANIMATION */
.animation-box{
    width:100%;
    height:120px;
    background:#eee;
    margin-top:20px;
    position:relative;
    overflow:hidden;
    border-radius:10px;
}
.circle{
    width:50px;
    height:50px;
    background:#04AA6D;
    border-radius:50%;
    position:absolute;
    top:35px;
    left:0;
    animation:move 4s infinite alternate;
}
@keyframes move{
    from{
        left:0;
    }
    to{
        left:85%;
    }
}
/* FOOTER */
.footer{
    background:#282A35;
    color:white;
    text-align:center;
    padding:20px;
    margin-top:30px;
}
/* RESPONSIVE */
@media(max-width:900px){
.menu{
    display:none;
}
.search{
    display:none;
}
.top-header{
    flex-direction:column;
    gap:10px;
}
.grail-container{
    grid-template-columns:1fr;
}
}
</style>
</head>
<body>
<!-- HEADER -->
<div class="header">
    <div class="top-header">
        <div class="left">
            <div class="logo">W3Schools</div>
            <div class="menu">
                <a href="#">Tutorials ▼</a>
                <a href="#">Exercises ▼</a>
                <a href="#">Certificates ▼</a>
                <a href="#">Services ▼</a>
            </div>
        </div>
        <div class="right">
            <div class="search">
                🔍 <input type="text" placeholder="Search">
            </div>
            <button class="btn">Log in</button>
        </div>
    </div>
    <!-- COURSE BAR -->
    <div class="course-bar">
        <a href="#" class="active">HTML</a>
        <a href="#">CSS</a>
        <a href="#">JavaScript</a>
        <a href="#">Python</a>
        <a href="#">SQL</a>
        <a href="#">Java</a>
        <a href="#">PHP</a>
    </div>
</div>
<!-- HOLY GRAIL LAYOUT -->
<div class="grail-container">
    <!-- LEFT SIDEBAR -->
    <div class="sidebar-left">
        <h3>Courses</h3>
        <p>HTML Tutorial</p>
        <p>CSS Tutorial</p>
        <p>JavaScript</p>
        <p>Python</p>
        <p>Bootstrap</p>
    </div>
    <!-- MAIN CONTENT -->
    <div class="main-content">
        <h2 align="center">Popular Courses</h2>
        <!-- TABLE -->
        <table>
            <tr>
                <th>Course</th>
                <th>Duration</th>
                <th>Fees</th>
            </tr>
            <tr>
                <td>HTML</td>
                <td>1 Month</td>
                <td>₹1000</td>
            </tr>
            <tr>
                <td>CSS</td>
                <td>1 Month</td>
                <td>₹1200</td>
            </tr>
            <tr>
                <td>JavaScript</td>
                <td>2 Months</td>
                <td>₹2000</td>
            </tr>
            <tr>
                <td>Python</td>
                <td>3 Months</td>
                <td>₹3000</td>
            </tr>
        </table>
        <!-- LOGIN FORM -->
        <div class="login-box">
            <h2>Login Form</h2>
            <form>
                <input type="text" placeholder="Enter Username">
                <input type="password" placeholder="Enter Password">
                <button type="submit">Login</button>
            </form>
        </div>
    </div>
    <!-- RIGHT SIDEBAR -->
    <div class="sidebar-right">
        <h3>Latest Updates</h3>
        <p>✔ New HTML Course</p>
        <p>✔ CSS Notes Added</p>
        <p>✔ JavaScript Quiz</p>
        <!-- ANIMATION -->
        <div class="animation-box">
            <div class="circle"></div>
        </div>
    </div>
</div>
<!-- FOOTER -->
<div class="footer">

    <h3>© 2026 W3Schools Clone Website</h3>

</div>

</body>
</html>
