<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cricbuzz Basic Header</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial, sans-serif;
    }

    body{
      background:#f5f5f5;
    }

    /* Header */
    header{
      background:#009270;
      color:white;
      padding:12px 25px;
      display:flex;
      justify-content:space-between;
      align-items:center;
    }

    /* Logo */
    .logo{
      font-size:28px;
      font-weight:bold;
    }

    /* Menu */
    nav ul{
      display:flex;
      list-style:none;
      gap:20px;
    }

    nav ul li a{
      color:white;
      text-decoration:none;
      font-size:15px;
    }

    nav ul li a:hover{
      text-decoration:underline;
    }

    /* Search */
    .search input{
      padding:6px 10px;
      border:none;
      border-radius:4px;
      outline:none;
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">Cricbuzz</div>

    <nav>
      <ul>
        <li><a href="#">Live Scores</a></li>
        <li><a href="#">Schedule</a></li>
        <li><a href="#">News</a></li>
        <li><a href="#">Series</a></li>
      </ul>
    </nav>

    <div class="search">
      <input type="text" placeholder="Search">
    </div>
  </header>

</body>
</html>
